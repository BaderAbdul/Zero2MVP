[debug] [2026-08-10T16:27:08.249Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/zero-2-mvp:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper Functions\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    \n    function getUserData() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function isRole(role) {\n      return isSignedIn() && getUserData().role == role;\n    }\n    \n    function isStaffAllowlisted(email, role) {\n      let docData = get(/databases/$(database)/documents/staff_allowlist/$(email)).data;\n      return docData != null && docData.role == role;\n    }\n\n    // users\n    match /users/{userId} {\n      allow read: if isSignedIn();\n      \n      // A user can create their profile.\n      // Default to 'participant'.\n      // If requesting a staff role, must be explicitly authorized in staff_allowlist by email.\n      allow create: if isSignedIn() && request.auth.uid == userId && (\n        (request.resource.data.role == 'participant') ||\n        (request.auth.token.email != null && isStaffAllowlisted(request.auth.token.email, request.resource.data.role))\n      );\n      \n      // Participant can join a team EXACTLY ONCE if they provide the correct joinCode\n      allow update: if isRole('organizer') || (\n        isSignedIn() && \n        request.auth.uid == userId && \n        resource.data.get('teamId', null) == null && \n        'teamId' in request.resource.data &&\n        'joinCode' in request.resource.data &&\n        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId', 'joinCode']) &&\n        get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == request.resource.data.joinCode\n      );\n\n      allow delete: if isRole('organizer');\n    }\n\n    // staff_allowlist\n    match /staff_allowlist/{email} {\n      allow read: if isSignedIn();\n      allow write: if isRole('organizer');\n    }\n\n    // camp_os/global_state\n    match /camp_os/global_state {\n      // Publicly readable for all connected clients (projector, participants, etc.)\n      allow read: if true;\n      // Only organizer can modify global state\n      allow write: if isRole('organizer');\n    }\n\n    // teams\n    match /teams/{teamId} {\n      allow read: if true;\n      \n      allow write: if isRole('organizer');\n      \n      // Mentor can update healthStatus and checkpointStatus/currentStage\n      allow update: if isRole('mentor') && \n        request.resource.data.diff(resource.data).affectedKeys()\n        .hasOnly(['healthStatus', 'checkpointStatus', 'currentStage']);\n        \n      // Participants update progressPercentage and completedTaskIds\n      allow update: if isRole('participant') && \n        getUserData().teamId == teamId &&\n        request.resource.data.diff(resource.data).affectedKeys()\n        .hasOnly(['progressPercentage', 'completedTaskIds', 'checkpointStatus']) &&\n        // Bounds checking\n        request.resource.data.progressPercentage >= 0 && \n        request.resource.data.progressPercentage <= 100;\n        \n      // Judges CANNOT update team directly anymore (derived from demo_scores)\n    }\n\n    // team interventions\n    match /teams/{teamId}/interventions/{interventionId} {\n      allow read: if true;\n      \n      // Participant can request intervention only if team health is NOT red/yellow\n      allow create: if isRole('participant') && \n        getUserData().teamId == teamId &&\n        get(/databases/$(database)/documents/teams/$(teamId)).data.healthStatus == 'green' &&\n        request.resource.data.status == 'open';\n        \n      allow update: if isRole('mentor') &&\n        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'mentorId', 'claimedAt', 'resolvedAt']);\n        \n      allow write: if isRole('organizer');\n    }\n\n    // team tasks\n    match /teams/{teamId}/tasks/{taskId} {\n      allow read: if true;\n      allow create: if isRole('participant') && getUserData().teamId == teamId;\n      allow write: if isRole('organizer');\n    }\n\n    // demo_scores\n    match /demo_scores/{scoreId} {\n      allow read: if true;\n      \n      // Judges can create/update scores\n      // ID must be {teamId}_{judgeId} to prevent duplicates\n      allow create, update: if isRole('judge') && \n        request.resource.data.judgeId == request.auth.uid &&\n        scoreId == (request.resource.data.teamId + '_' + request.auth.uid);\n      \n      allow write: if isRole('organizer');\n    }\n\n    // camp_logs\n    match /camp_logs/{logId} {\n      allow read: if isRole('organizer');\n      \n      // Append only logs\n      allow create: if isSignedIn() &&\n        request.resource.data.actorId == request.auth.uid &&\n        request.resource.data.actorRole == getUserData().role &&\n        request.resource.data.type is string &&\n        request.resource.data.timestamp is number;\n        \n      allow update, delete: if false;\n    }\n  }\n}\n"}]}}
