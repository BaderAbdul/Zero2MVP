rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isRole(role) {
      return isSignedIn() && getUserData().role == role;
    }
    
    function isStaffAllowlisted(email, role) {
      let docData = get(/databases/$(database)/documents/staff_allowlist/$(email)).data;
      return docData != null && docData.role == role;
    }

    // users
    match /users/{userId} {
      allow read: if isSignedIn();
      
      // A user can create their profile.
      // Default to 'participant'.
      // If requesting a staff role, must be explicitly authorized in staff_allowlist by email.
      allow create: if isSignedIn() && request.auth.uid == userId && (
        (request.resource.data.role == 'participant') ||
        (request.auth.token.email != null && isStaffAllowlisted(request.auth.token.email, request.resource.data.role))
      );
      
      // Participant can join a team EXACTLY ONCE if they provide the correct joinCode
      allow update: if isRole('organizer') || (
        isSignedIn() && 
        request.auth.uid == userId && 
        resource.data.get('teamId', null) == null && 
        'teamId' in request.resource.data &&
        'joinCode' in request.resource.data &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamId', 'joinCode']) &&
        get(/databases/$(database)/documents/teams/$(request.resource.data.teamId)).data.joinCode == request.resource.data.joinCode
      );

      allow delete: if isRole('organizer');
    }

    // staff_allowlist
    match /staff_allowlist/{email} {
      allow read: if isSignedIn();
      allow write: if isRole('organizer');
    }

    // camp_os/global_state
    match /camp_os/global_state {
      // Publicly readable for all connected clients (projector, participants, etc.)
      allow read: if true;
      // Only organizer can modify global state
      allow write: if isRole('organizer');
    }

    // teams
    match /teams/{teamId} {
      allow read: if true;
      
      allow write: if isRole('organizer');
      
      // Mentor/Organizer can update healthStatus and checkpointStatus/currentStage
      allow update: if (isRole('mentor') || isRole('organizer')) && 
        request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['healthStatus', 'checkpointStatus', 'currentStage', 'submissions', 'helpRequests']);
        
      // Participants update progressPercentage, completedTaskIds, taskStatuses, submissions, helpRequests, submittedDeliverableUrl
      allow update: if isRole('participant') && 
        getUserData().teamId == teamId &&
        request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['progressPercentage', 'completedTaskIds', 'checkpointStatus', 'taskStatuses', 'submissions', 'helpRequests', 'submittedDeliverableUrl', 'healthStatus']) &&
        // Bounds checking
        request.resource.data.progressPercentage >= 0 && 
        request.resource.data.progressPercentage <= 100;
        
      // Judges CANNOT update team directly (derived from demo_scores)
    }

    // team interventions
    match /teams/{teamId}/interventions/{interventionId} {
      allow read: if true;
      
      // Participant can request intervention only if team health is NOT red/yellow
      allow create: if isRole('participant') && 
        getUserData().teamId == teamId &&
        request.resource.data.status == 'open';
        
      allow update: if (isRole('mentor') || isRole('organizer')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'mentorId', 'claimedAt', 'resolvedAt']) &&
        (
          // Open -> Claimed
          (resource.data.status == 'open' && request.resource.data.status == 'claimed') ||
          // Claimed -> Resolved
          (resource.data.status == 'claimed' && request.resource.data.status == 'resolved')
        );
        
      allow write: if isRole('organizer');
    }

    // team tasks
    match /teams/{teamId}/tasks/{taskId} {
      allow read: if true;
      allow create: if isRole('participant') && getUserData().teamId == teamId;
      allow write: if isRole('organizer');
    }

    // demo_scores
    match /demo_scores/{scoreId} {
      allow read: if true;
      
      // Judges or Organizers can create/update scores
      allow create, update: if (isRole('judge') || isRole('organizer')) && 
        scoreId == (request.resource.data.teamId + '_' + request.auth.uid);
      
      allow write: if isRole('organizer');
    }

    // camp_logs
    match /camp_logs/{logId} {
      allow read: if isRole('organizer');
      
      // Append only logs
      allow create: if isSignedIn() &&
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.actorRole == getUserData().role &&
        request.resource.data.type is string &&
        request.resource.data.timestamp is number;
        
      allow update, delete: if false;
    }
  }
}
